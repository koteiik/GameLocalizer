<Project>
  <Target Name="CopyLocalModelHost" AfterTargets="Build" Condition="'$(MSBuildProjectName)' == 'GameLocalizer.UI' Or '$(MSBuildProjectName)' == 'GameLocalizer.Smoke'">
    <ItemGroup>
      <ModelHostFiles Include="$(MSBuildThisFileDirectory)src/GameLocalizer.ModelHost/bin/$(Configuration)/net8.0-windows/$(RuntimeIdentifier)/GameLocalizer.ModelHost.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModelHostFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishLocalModelHost" AfterTargets="Publish" Condition="'$(MSBuildProjectName)' == 'GameLocalizer.UI'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)src/GameLocalizer.ModelHost/GameLocalizer.ModelHost.csproj" Targets="Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir)" />
    <Error Condition="!Exists('$(PublishDir)GameLocalizer.ModelHost.exe')" Text="Local model host missing from publish output" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)src/GameLocalizer.Updater/GameLocalizer.Updater.csproj" Targets="Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir)Updater/" />
    <Error Condition="!Exists('$(PublishDir)Updater/GameLocalizer.Updater.exe')" Text="Updater missing from publish output" />
  </Target>
  <Target Name="CopyLocalUpdater" AfterTargets="Build" Condition="'$(MSBuildProjectName)' == 'GameLocalizer.UI'">
    <ItemGroup><UpdaterFiles Include="$(MSBuildThisFileDirectory)src/GameLocalizer.Updater/bin/$(Configuration)/net8.0-windows/$(RuntimeIdentifier)/**/*" /></ItemGroup>
    <Copy SourceFiles="@(UpdaterFiles)" DestinationFiles="@(UpdaterFiles->'$(TargetDir)Updater/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CleanDistributionLayout" AfterTargets="Publish" DependsOnTargets="PublishLocalModelHost" Condition="'$(MSBuildProjectName)' == 'GameLocalizer.UI' and '$(RuntimeIdentifier)' == 'win-x64' and '$(UseCleanDistributionLayout)' != 'false'">
    <ItemGroup>
      <_DistributionFiles Include="$(PublishDir)**/*" Exclude="$(PublishDir)GameLocalizer.exe;$(PublishDir)app/**/*" />
    </ItemGroup>
    <Move SourceFiles="@(_DistributionFiles)" DestinationFiles="@(_DistributionFiles->'$(PublishDir)app/%(RecursiveDir)%(Filename)%(Extension)')" />
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)" AppHostDestinationPath="$(PublishDir)GameLocalizer.exe" AppBinaryName="app/GameLocalizer.dll" IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')" WindowsGraphicalUserInterface="true" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts/Normalize-PublishLayout.ps1&quot; -PublishDirectory &quot;$(PublishDir).&quot;" />
  </Target>
</Project>
