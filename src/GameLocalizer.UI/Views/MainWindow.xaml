<Window x:Class="GameLocalizer.UI.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="{Binding WindowTitle}" Width="1360" Height="860" MinWidth="1060" MinHeight="650">
  <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style x:Key="SecondaryAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#25354A"/><Setter Property="Foreground" Value="#BCD0E9"/></Style>
  <Style x:Key="PreviewText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
  <Style x:Key="RussianEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="MaxHeight" Value="120"/><Setter Property="ToolTip" Value="{Binding Russian}"/></Style>
 </Window.Resources>
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel>
  <DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Настройки" Command="{Binding SettingsCommand}"/><Button Content="О программе" Command="{Binding AboutCommand}"/><Button Content="Сообщить о проблеме" Command="{Binding IssuesCommand}"/></StackPanel><StackPanel><TextBlock Text="GameLocalizer" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="{Binding VersionDescription}" Foreground="#9AAFCB"/></StackPanel></DockPanel>
  <Border Background="#203750" Padding="12" Margin="0,0,0,12" DataContext="{Binding Updates}" Visibility="{Binding Visible, Converter={StaticResource BoolVisibility}}">
   <StackPanel><WrapPanel><TextBlock Text="{Binding Banner}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4"/><Button Content="Обновить" Command="{Binding UpdateCommand}"/><Button Content="Что нового" Command="{Binding NotesCommand}"/><Button Content="Позже" Command="{Binding LaterCommand}"/><Button Content="Скачать вручную" Command="{Binding ManualDownloadCommand}"/><Button Content="Отмена" Command="{Binding CancelCommand}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/></WrapPanel><TextBlock Text="{Binding BlockReason}" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><ProgressBar Height="6" Margin="4" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/></StackPanel>
  </Border></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <DockPanel Background="{StaticResource Panel}"><StackPanel DockPanel.Dock="Top" Margin="8"><TextBlock Text="БИБЛИОТЕКА ИГР" Margin="6" Foreground="#9AAFCB"/><Button Content="Обновить Steam" Command="{Binding InitializeCommand}"/><Button Content="Добавить игру вручную" Command="{Binding AddCommand}"/></StackPanel><ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSynchronizedWithCurrentItem="False" Background="Transparent" Foreground="White" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Platform}" Foreground="#9AAFCB" FontSize="11"/><TextBlock Text="{Binding Engine}" Foreground="#96BFF8" FontSize="11"/><TextBlock Text="{Binding Status}" Foreground="#9AAFCB" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="{Binding SelectedGame.Name, TargetNullValue=Выберите игру}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedGame.Path}" ToolTip="{Binding SelectedGame.Path}" Margin="0,4" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SelectedGame.Platform}" Foreground="#9AAFCB"/><TextBlock Text="{Binding EngineSummary}" ToolTip="{Binding Engine}" Foreground="#96BFF8" TextTrimming="CharacterEllipsis"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,10,0,8">
     <WrapPanel x:Name="ActionToolbar">
      <StackPanel x:Name="WorkflowActions" Orientation="Horizontal" Margin="0,0,12,4"><Button Content="Анализировать" Command="{Binding AnalyzeCommand}"/><Button Content="{Binding FindButtonLabel}" Command="{Binding FindCommand}" ToolTip="Правой кнопкой: полный перескан или забыть анализ"><Button.ContextMenu><ContextMenu><MenuItem Header="Обновить анализ" Command="{Binding RefreshAnalysisCommand}"/><MenuItem Header="Полный перескан" Command="{Binding FullRescanCommand}"/><Separator/><MenuItem Header="Забыть анализ игры" Command="{Binding ForgetAnalysisCommand}"/></ContextMenu></Button.ContextMenu></Button><Button Content="Перевести" Command="{Binding TranslateCommand}"/><Button Content="Перевести заново" Command="{Binding RetranslateCommand}" Style="{StaticResource SecondaryAction}"/></StackPanel>
      <StackPanel x:Name="ApplyActions" Orientation="Horizontal" Margin="0,0,12,4"><Button Content="Применить" Command="{Binding ApplyCommand}" Background="#276B64"/><Button Content="Восстановить" Command="{Binding RestoreCommand}" Style="{StaticResource SecondaryAction}"/><Button Content="Убрать" Command="{Binding CleanupCommand}" Style="{StaticResource SecondaryAction}" ToolTip="Восстановить оригиналы и удалить файлы/папки, созданные GameLocalizer."/></StackPanel>
      <StackPanel x:Name="DiagnosticActions" Orientation="Horizontal" Margin="0,0,0,4"><Button Content="Отчёт" Command="{Binding OpenDiagnosticReportCommand}" Style="{StaticResource SecondaryAction}" ToolTip="{Binding DiagnosticReportToolTip}" ToolTipService.ShowOnDisabled="True"/><Button Content="Открыть журнал" Command="{Binding OpenScanLogCommand}" Style="{StaticResource SecondaryAction}" ToolTip="Подробности ошибок сканирования"/></StackPanel>
     </WrapPanel>
     <TextBlock Text="{Binding ProviderDescription}" Foreground="#9AAFCB" Margin="3,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProviderDescription}"/>
    </StackPanel>
    <StackPanel Grid.Row="2" IsEnabled="{Binding Idle}"><WrapPanel><TextBlock Text="Поиск" VerticalAlignment="Center"/><TextBox Width="185" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Файл" VerticalAlignment="Center"/><TextBox Width="140" Text="{Binding FileFilter, UpdateSourceTrigger=PropertyChanged}"/><ComboBox Width="175" Margin="4" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" ToolTip="Все: от 60%. Высокая уверенность: от 85% и игровой источник. Сомнительные: ниже 85% или Possible. Технические: отклонённые строки обычных ресурсов. Два последних фильтра не учитывают ползунок."/><ComboBox Width="150" Margin="4" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"/></WrapPanel><WrapPanel Margin="0,4"><TextBlock Text="Confidence ≥" VerticalAlignment="Center"/><Slider Width="130" Margin="8" Minimum="0" Maximum="1" Value="{Binding MinimumConfidence}"/><TextBlock Text="{Binding MinimumConfidence, StringFormat=F2}" VerticalAlignment="Center"/><Button Content="Выбрать страницу" Command="{Binding SelectVisibleCommand}"/><Button Content="Снять страницу" Command="{Binding ClearVisibleCommand}"/></WrapPanel><WrapPanel><TextBlock Text="Сортировка всего набора" VerticalAlignment="Center"/><ComboBox Width="115" Margin="5" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}"/><CheckBox Content="По убыванию" IsChecked="{Binding Descending}"/><Button Content="← Назад" Command="{Binding PreviousPageCommand}"/><TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" Margin="6"/><Button Content="Далее →" Command="{Binding NextPageCommand}"/></WrapPanel><TextBlock Text="{Binding CoverageSummary}" TextWrapping="Wrap" FontSize="11" Foreground="#9AAFCB" Margin="4,4"/><TextBlock Text="{Binding Counters}" TextWrapping="Wrap" ToolTip="Счётчики всего набора: пользовательский текст ≥85% и игровой источник, сомнительные &lt;85% или Possible, технические отклонены. Исключённые файлы и каталоги не читаются и в строки не входят." Margin="4,4,4,8" Foreground="#96BFF8"/></StackPanel>
    <TabControl SelectedIndex="{Binding PreviewTabIndex}" Grid.Row="3" Background="#182335" BorderThickness="0"><TabItem Header="Предпросмотр"><DataGrid x:Name="PreviewGrid" ItemsSource="{Binding Rows}" IsEnabled="{Binding Idle}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="False" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" CanUserSortColumns="False"><DataGrid.Columns>
     <DataGridTemplateColumn Header="✓" Width="40"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="Key" Binding="{Binding Key}" IsReadOnly="True" Width="1.2*" MinWidth="65" ElementStyle="{StaticResource PreviewText}"/>
     <DataGridTextColumn Header="Original" Binding="{Binding Original}" IsReadOnly="True" Width="2*" MinWidth="110" ElementStyle="{StaticResource PreviewText}"/>
     <DataGridTextColumn Header="Russian" Binding="{Binding Russian, UpdateSourceTrigger=PropertyChanged}" Width="2*" MinWidth="120" ElementStyle="{StaticResource PreviewText}" EditingElementStyle="{StaticResource RussianEditor}"/>
          <DataGridTextColumn Header="File" Binding="{Binding FileName}" IsReadOnly="True" Width="95"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource PreviewText}"><Setter Property="ToolTip" Value="{Binding FileToolTip}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
     <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" IsReadOnly="True" Width="50" ElementStyle="{StaticResource PreviewText}"/>
     <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="75" ElementStyle="{StaticResource PreviewText}"/>
     <DataGridTextColumn Header="Conf." Binding="{Binding Confidence, StringFormat=F2}" IsReadOnly="True" Width="50" ElementStyle="{StaticResource PreviewText}"/>
          <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" IsReadOnly="True" Width="95"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource PreviewText}"><Setter Property="ToolTip" Value="{Binding Status}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
    </DataGrid.Columns></DataGrid></TabItem><TabItem Header="Найденные ресурсы"><DataGrid ItemsSource="{Binding Resources}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Файл" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Класс" Binding="{Binding Kind}" Width="150"/><DataGridTextColumn Header="Формат" Binding="{Binding Format}" Width="120"/><DataGridTextColumn Header="Поддержка" Binding="{Binding Detail}" Width="250"/></DataGrid.Columns></DataGrid></TabItem>     <TabItem Header="Unsupported UI"><DockPanel><TextBlock DockPanel.Dock="Top" Text="{Binding UiDiscoveryNotes}" TextWrapping="Wrap" Margin="8"/><DataGrid ItemsSource="{Binding UnsupportedUi}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="2*" ElementStyle="{StaticResource PreviewText}"/><DataGridTextColumn Header="Source file" Binding="{Binding SourceFile}" Width="2*" ElementStyle="{StaticResource PreviewText}"/><DataGridTextColumn Header="Probable resource type" Binding="{Binding ProbableResourceType}" Width="*" ElementStyle="{StaticResource PreviewText}"/><DataGridCheckBoxColumn Header="Writable" Binding="{Binding Writable}" Width="65"/><DataGridTextColumn Header="Support status" Binding="{Binding SupportStatus}" Width="*" ElementStyle="{StaticResource PreviewText}"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
     <TabItem Header="Поиск UI"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="8"><WrapPanel><TextBox Width="220" Text="{Binding UiSearchTerm, UpdateSourceTrigger=PropertyChanged}" ToolTip="Например: Give Advice или Give Item"/><Button Content="Найти строку в ресурсах" Command="{Binding SearchUiResourcesCommand}"/></WrapPanel><TextBlock Text="{Binding UiDiscoveryNotes}" TextWrapping="Wrap"/></StackPanel><DataGrid ItemsSource="{Binding UiSearchResults}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="2*" ElementStyle="{StaticResource PreviewText}"/><DataGridTextColumn Header="Source" Binding="{Binding SourceFile}" Width="2*" ElementStyle="{StaticResource PreviewText}"/><DataGridTextColumn Header="Resource type" Binding="{Binding ProbableResourceType}" Width="*" ElementStyle="{StaticResource PreviewText}"/><DataGridCheckBoxColumn Header="Writable" Binding="{Binding Writable}" Width="65"/><DataGridTextColumn Header="Match" Binding="{Binding MatchKind}" Width="110"/><DataGridTextColumn Header="Support" Binding="{Binding SupportStatus}" Width="*" ElementStyle="{StaticResource PreviewText}"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
    </TabControl>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="Остановить операцию / перевод" Command="{Binding CancelCommand}"/><ProgressBar DockPanel.Dock="Right" Width="110" Height="5" IsIndeterminate="{Binding Busy}" Margin="10"/><StackPanel><TextBlock Text="{Binding StatusSummary}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis" Foreground="#BCD0E9"/><TextBlock Text="{Binding ProgressSummary}" ToolTip="{Binding ProgressText}" TextTrimming="CharacterEllipsis" Foreground="#96BFF8"/></StackPanel></DockPanel>
 </Grid>
</Window>
