<Window x:Class="GameLocalizer.UI.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="{Binding WindowTitle}" Width="1360" Height="860" MinWidth="1060" MinHeight="650">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Настройки" Command="{Binding SettingsCommand}"/><Button Content="О программе" Command="{Binding AboutCommand}"/><Button Content="Сообщить о проблеме" Command="{Binding IssuesCommand}"/></StackPanel><StackPanel><TextBlock Text="GameLocalizer" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="{Binding VersionDescription}" Foreground="#9AAFCB"/></StackPanel></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <DockPanel Background="{StaticResource Panel}"><StackPanel DockPanel.Dock="Top" Margin="8"><TextBlock Text="БИБЛИОТЕКА ИГР" Margin="6" Foreground="#9AAFCB"/><Button Content="Обновить Steam" Command="{Binding InitializeCommand}"/><Button Content="Добавить игру вручную" Command="{Binding AddCommand}"/></StackPanel><ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSynchronizedWithCurrentItem="False" Background="Transparent" Foreground="White" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Platform}" Foreground="#9AAFCB" FontSize="11"/><TextBlock Text="{Binding Engine}" Foreground="#96BFF8" FontSize="11"/><TextBlock Text="{Binding Status}" Foreground="#9AAFCB" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="{Binding SelectedGame.Name, TargetNullValue=Выберите игру}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedGame.Path}" Margin="0,4" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SelectedGame.Platform}" Foreground="#9AAFCB"/><TextBlock Text="{Binding Engine}" Foreground="#96BFF8" TextWrapping="Wrap"/></StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,12"><Button Content="Анализировать" Command="{Binding AnalyzeCommand}"/><Button Content="Найти текст" Command="{Binding FindCommand}"/><Button Content="Перевести" Command="{Binding TranslateCommand}"/><Button Content="Перевести заново" Command="{Binding RetranslateCommand}"/><TextBlock Text="{Binding ProviderDescription}" VerticalAlignment="Center" Margin="8"/><Button Content="Применить" Command="{Binding ApplyCommand}" Background="#276B64"/><Button Content="Восстановить" Command="{Binding RestoreCommand}"/></WrapPanel>
    <StackPanel Grid.Row="2" IsEnabled="{Binding Idle}"><WrapPanel><TextBlock Text="Поиск" VerticalAlignment="Center"/><TextBox Width="185" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Файл" VerticalAlignment="Center"/><TextBox Width="140" Text="{Binding FileFilter, UpdateSourceTrigger=PropertyChanged}"/><ComboBox Width="175" Margin="4" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" ToolTip="Все: от 60%. Высокая уверенность: от 85%. Сомнительные: ниже 85%. Технические: отклонённые строки обычных ресурсов. Два последних фильтра не учитывают ползунок."/><ComboBox Width="150" Margin="4" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"/></WrapPanel><WrapPanel Margin="0,4"><TextBlock Text="Confidence ≥" VerticalAlignment="Center"/><Slider Width="130" Margin="8" Minimum="0" Maximum="1" Value="{Binding MinimumConfidence}"/><TextBlock Text="{Binding MinimumConfidence, StringFormat=F2}" VerticalAlignment="Center"/><Button Content="Выбрать страницу" Command="{Binding SelectVisibleCommand}"/><Button Content="Снять страницу" Command="{Binding ClearVisibleCommand}"/></WrapPanel><WrapPanel><TextBlock Text="Сортировка всего набора" VerticalAlignment="Center"/><ComboBox Width="115" Margin="5" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}"/><CheckBox Content="По убыванию" IsChecked="{Binding Descending}"/><Button Content="← Назад" Command="{Binding PreviousPageCommand}"/><TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" Margin="6"/><Button Content="Далее →" Command="{Binding NextPageCommand}"/></WrapPanel><TextBlock Text="{Binding Counters}" TextWrapping="Wrap" ToolTip="Счётчики всего набора: пользовательский текст ≥85%, сомнительные &lt;85%, технические отклонены. Исключённые файлы и каталоги не читаются и в строки не входят." Margin="4,4,4,8" Foreground="#96BFF8"/></StackPanel>
    <TabControl Grid.Row="3" Background="#182335" BorderThickness="0"><TabItem Header="Предпросмотр"><DataGrid ItemsSource="{Binding Rows}" IsEnabled="{Binding Idle}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" CanUserSortColumns="False"><DataGrid.Columns>
     <DataGridTemplateColumn Header="✓" Width="40"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="Original" Binding="{Binding Original}" IsReadOnly="True" Width="2*"/>
     <DataGridTextColumn Header="Russian — редактируется" Binding="{Binding Russian, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
     <DataGridTextColumn Header="File" Binding="{Binding File}" IsReadOnly="True" Width="130"/>
     <DataGridTextColumn Header="Key" Binding="{Binding Key}" IsReadOnly="True" Width="90"/>
     <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="100"/>
     <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, StringFormat=F2}" IsReadOnly="True" Width="80"/>
     <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="115"/>
    </DataGrid.Columns></DataGrid></TabItem><TabItem Header="Найденные ресурсы"><DataGrid ItemsSource="{Binding Resources}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Файл" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Класс" Binding="{Binding Kind}" Width="150"/><DataGridTextColumn Header="Формат" Binding="{Binding Format}" Width="120"/><DataGridTextColumn Header="Поддержка" Binding="{Binding Detail}" Width="250"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="Остановить операцию / перевод" Command="{Binding CancelCommand}"/><ProgressBar DockPanel.Dock="Right" Width="110" Height="5" IsIndeterminate="{Binding Busy}" Margin="10"/><StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#BCD0E9"/><TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" Foreground="#96BFF8"/></StackPanel></DockPanel>
 </Grid>
</Window>
